[{"hash": "c2016a904921978b13d27f11c6e2e59562a60ecc", "date": "2026-06-15", "version": "v5.0.0.414", "description": "orchestrator: fix _running stays True after startup, blocking on-demand permission dialogs", "files_changed": 2, "root_cause": "orchestrator._running stays True after startup (COMPLETED ledger path missing self._running = False). is_running=True permanently causes all on-demand permission requests to take fire-and-forget deferred path \u2014 action fails before dialog appears", "solution": "Added self._running = False before return in orchestrator.start() COMPLETED path", "verified": false, "status": "resolved", "notes": ""}, {"hash": "2f23e05b1f6965ff2a68a981ea2194bc24e2bf60", "date": "2026-06-14", "version": "v5.0.0.413", "description": "CLAUDE.md: add response-formatting rules to \u0421\u0442\u0438\u043b\u044c \u043e\u0442\u0432\u0435\u0442\u043e\u0432", "files_changed": 2, "root_cause": "A previous session had added 3 response-formatting rules to CLAUDE.md \u0421\u0442\u0438\u043b\u044c \u043e\u0442\u0432\u0435\u0442\u043e\u0432 section but left the change uncommitted/unrelated to its own release.", "solution": "Committed the leftover hunk as its own release (v5.0.0.413): added rules for short bullet/table format for user docs, \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u2192\u041a\u043e\u0440\u0435\u043d\u044c\u2192\u0413\u0438\u043f\u043e\u0442\u0435\u0437\u044b structure for problem discussions, and diagram/table presentation for complex topics.", "verified": false, "status": "resolved", "notes": ""}, {"hash": "479307fec75a17e1e732fa8fc582a190a229d64c", "date": "2026-06-14", "version": "v5.0.0.412", "description": "workflow: link every release commit to map Changelog", "files_changed": 5, "root_cause": "POST /changelog/<hash> endpoint existed in server.py and was documented in tools/map.md, but CLAUDE.md workflow (\u0428\u0430\u0433 3.7) never called it, so every release commit Changelog entry showed empty root_cause/solution/status.", "s